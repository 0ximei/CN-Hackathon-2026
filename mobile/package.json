    "expo-build-properties": "~1.0.0",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.0",
    "expo-document-picker": "~14.0.0",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "llama.rn": "^0.11.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
