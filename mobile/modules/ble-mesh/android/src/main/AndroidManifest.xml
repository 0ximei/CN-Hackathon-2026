<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <!--
    neverForLocation is what lets a scan run on Android 12+ without the app
    holding a location permission. The mesh only cares that a peer is in radio
    range, never where it is, so the stronger grant would be asking for
    something the feature does not use.
  -->
  <uses-permission
    android:name="android.permission.BLUETOOTH_SCAN"
    android:usesPermissionFlags="neverForLocation" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

  <!-- Pre-12 devices have no split permissions: scanning implies location. -->
  <uses-permission
    android:name="android.permission.BLUETOOTH"
    android:maxSdkVersion="30" />
  <uses-permission
    android:name="android.permission.BLUETOOTH_ADMIN"
    android:maxSdkVersion="30" />
  <uses-permission
    android:name="android.permission.ACCESS_FINE_LOCATION"
    android:maxSdkVersion="30" />

  <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

  <!--
    Keeping the radio up after the user leaves the app. A process that is not
    foreground is starved of CPU and killed outright when the app is swiped from
    recents, and a radio cannot be resumed afterwards — links drop, the node
    stops advertising, and every peer routing through it has to relearn the mesh.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!-- Required from Android 14 to declare the `connectedDevice` type below. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <!--
    From Android 13 a notification needs the user's consent. The service still
    runs if it is refused; the disclosure is what disappears, which is worth
    saying in the UI rather than silently accepting.
  -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!--
    Held by React Native's HeadlessJsTaskService for the life of the background
    task, and not optional: `acquireWakeLockNow` throws a SecurityException
    without it, which would take background mode down the first time it was
    switched on. It is also the right behaviour — a phone in Doze stops
    delivering the timers the mesh is made of, so a daemon that let the CPU
    sleep would be a daemon in name only.
  -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <!--
      `stopWithTask=false` is the default, and it is stated because it is the
      point: swiping the app out of recents must not take the service with it.
    -->
    <service
      android:name=".MeshService"
      android:exported="false"
      android:stopWithTask="false"
      android:foregroundServiceType="connectedDevice" />
  </application>
</manifest>
