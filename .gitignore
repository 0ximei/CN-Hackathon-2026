# --- React Native / Android ---

# Regenerated by `expo prebuild` from app.json and the local modules. Nothing
# in here is hand-edited, and committing it means every prebuild shows up as a
# few thousand lines of diff.
mobile/android/
mobile/ios/

# Gradle output for the local native modules. These live under mobile/modules/
# rather than mobile/android/, so the rules above do not reach them — this is
# what puts ~1500 build artifacts in `git status` after a build.
**/android/build/
**/android/.gradle/
**/android/.cxx/
**/android/.kotlin/

# Expo and Metro caches
.expo/
.expo-shared/
.metro-health-check*

# Build outputs and signing material. The keystore especially: committing one
# hands out the ability to publish updates as this app.
*.apk
*.aab
*.keystore
*.jks
local.properties

# IDE state from opening the generated project in Android Studio
.idea/
*.iml
*.hprof
